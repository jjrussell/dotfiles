# Add RVM to PATH for scripting
# for some reason adding it to the path if its already there messes with rvm-prompt command
# this can happen if we re-source this file
# This loads RVM into a shell session.
if command -v rbenv > /dev/null 2>&1 ; then
    __debug "Deferring rbenv initialization"
    rbenv() {
        unset -f rbenv
        if [[ $SHELL == *zsh* ]] ; then
            eval "$(command rbenv init - zsh)"
        else
            eval "$(command rbenv init -)"
        fi
        rbenv "$@"
    }
elif [[ -s "$HOME/.rvm/scripts/rvm" ]] ; then
    . "$HOME/.rvm/scripts/rvm"
    #PATH=$PATH:$HOME/.rvm/bin # Add RVM to PATH for scripting

    __debug "Adding rvm to path. rvm_bin_path=${rvm_bin_path}, PATH=${PATH}"
    [ -n "$rvm_bin_path" ] && echo $PATH | grep -q "$rvm_bin_path" || PATH=${rvm_bin_path}:${PATH}


    # https://github.com/rvm/rvm/issues/3620
    # suppress path warnings when rvm isn't first in the path. Leave my path alone
    export rvm_silence_path_mismatch_check_flag=1

    # some functions used for displaying active rvm ruby in prompt
    [ -r "$rvm_path/contrib/ps1_functions" ] && source "$rvm_path/contrib/ps1_functions"
fi




