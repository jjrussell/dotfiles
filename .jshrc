ruby_check(){
    local BAD_SYNTAX=""
    for RB in $(find . -name *.rb) ; do echo -n "$RB -- " ; ruby -c $RB || BAD_SYNTAX="$BAD_SYNTAX\n$RB" ; done
    if [ -n "$BAD_SYNTAX" ] ; then
        echo "Files with syntax errors"
        echo "$RB"
        return 1
    else
        echo ""
        echo "All files have valid syntax"
    fi
}


#############################################################
##
## GIT
##
#############################################################
#
# Will return the current branch name
# Usage example: git pull origin $(current_branch)
#
current_branch() {
    ref=$(\git symbolic-ref HEAD 2> /dev/null) || return
    echo ${ref#refs/heads/}
}

# echo * if we are in a git branch and it is dirty. used in prompt
parse_git_dirty () {
    if [[ -n $(\git status -s 2> /dev/null) ]]; then
        echo "*"
        return 1
    else
        echo ""
        return 0
    fi
}

# get the name of the branch we are on
git_prompt_info() {
    ref=$(\git symbolic-ref HEAD 2> /dev/null) || return
    echo "git:($(current_branch)$(parse_git_dirty))"
}

git-stale-worktrees() {
    local current_wt=""
    while IFS= read -r line; do
        if [[ "$line" == worktree\ * ]]; then
            current_wt="${line#worktree }"
        elif [[ "$line" == branch\ * ]]; then
            local b="${line#branch refs/heads/}"
            [[ $(git branch -vv --list "$b") == *": gone]"* ]] && echo "$current_wt"
        fi
    done < <(git worktree list --porcelain)
}

# Set up git worktree(s) for a new task and cd into the result.
# See ~/.bin/start-task.sh for the full behavior. The script prints the
# directory to land in on stdout; everything else goes to stderr.
start-task() {
    local dest
    dest="$(~/.bin/start-task.sh "$@")" || return $?
    if [ -n "$dest" ] && [ -d "$dest" ]; then
        cd "$dest"
    fi
}

# switch to either develop or master, get latest and rebase the branch I was on with that branch we just pulled
# if the branch is fully merged, delete it instead of rebasing
grb() {
    if [ -z "$TARGET_BRANCH" ] ; then
        local TARGET_BRANCH=master
        if git branch | egrep -q "^[ ]*develop$" && [ ! "$(current_branch)" = "develop" ]  ; then
            TARGET_BRANCH=develop
        fi
    fi

    local original_branch=$(current_branch)

    if [ "$original_branch" = "$TARGET_BRANCH" ] ; then
        echo ""
        echo "Already on $TARGET_BRANCH — fetching, pruning, and pulling"
        echo "-------------------------------"
        git fetch --prune origin && git pull origin $TARGET_BRANCH
        return
    fi
    echo ""
    echo "Fetching and pruning remote refs"
    echo "-------------------------------"
    git fetch --prune origin

    local unmerged=$(git log --oneline $TARGET_BRANCH..$original_branch)

    if [ -z "$unmerged" ] ; then
        echo ""
        echo "$original_branch is fully merged into $TARGET_BRANCH — deleting"
        echo "-------------------------------"
        git checkout $TARGET_BRANCH || return 1
        git pull origin $TARGET_BRANCH || return 1
        git branch -d $original_branch || {
            echo "Remote ref gone after confirmed merge — force-deleting $original_branch"
            git branch -D $original_branch
        }
    else
        echo ""
        echo "Pulling latest for branch $original_branch"
        echo "-------------------------------"
        git pull origin $original_branch || echo "Branch not pushed yet or remote already deleted — skipping"
        echo ""
        echo "Checking out $TARGET_BRANCH"
        echo "-------------------------------"
        git checkout $TARGET_BRANCH || return 1
        echo ""
        echo "Pulling $TARGET_BRANCH"
        echo "-------------------------------"
        git pull origin $TARGET_BRANCH || return 1
        echo ""
        echo "Switching back to $original_branch"
        echo "-------------------------------"
        git checkout $original_branch || return 1
        echo ""
        echo "Rebasing $original_branch onto $TARGET_BRANCH"
        echo "-------------------------------"
        git rebase $TARGET_BRANCH || return 1
    fi
}

hubpr() {
    PR_URL="$(hub pr list -h $(current_branch) -f "%U%n")"
    if [ -n "$PR_URL" ] ; then
        open "$PR_URL"
    else
        echo "Pushing $(current_branch) and creating new PR for the current branch"
        git push origin $(current_branch) && hub pull-request -o
    fi
}

alias req="pull_request"


# git-status-emacs() {
#     emacsclient --eval "(shell-git-status \"$PWD\")" ; runemacs
# }
# alias gse=git-status-emacs

clean_branches() {
    local original_branch=$(current_branch)

    local TARGET_BRANCH=master
    # if we have devlop and we're merged there, we're good if its there
    if git branch | egrep -q "^[\* ]*develop$"  ; then
        TARGET_BRANCH=develop
    fi
    echo "-------------------------------"
    echo "Checking out and pulling $TARGET_BRANCH"
    echo "-------------------------------"
    git checkout $TARGET_BRANCH
    git fetch
    git pull origin $(current_branch)
    echo "-------------------------------"
    echo "Pruning remote origin"
    echo "-------------------------------"
    git remote prune origin
    #    for BRANCH in $(git branch --merged | \grep -v "\*" | \grep "/" ) ; do
    for BRANCH in $(git branch --merged | \grep -v "\*" ) ; do
        echo "-------------------------------"
        echo "Deleting merged branch $BRANCH"
        echo "-------------------------------"
        git branch -d $BRANCH
    done

    # were we on master or develop when we started?
    if [ ! "$(current_branch)" = "$original_branch" ] ; then
        # If we didn't delete the original branch above because it was merged
        # then try to check it out again
        if git branch | grep -q $original_branch ; then
            git checkout $original_branch
        fi
    fi
}

# Do any local cleanup, run a build, and push if it passes
clean_push() {
    if [ ! -d .git ] ; then
        echo "Must be run from root of git repo"
        return 1
    fi
    # cleans up ordering in pom files
    mvn com.github.ekryd.sortpom:sortpom-maven-plugin:sort -Dsort.keepBlankLines -Dsort.sortDependencies=scope,groupId,artifactId -Dsort.createBackupFile=false
    
    if ! parse_git_dirty ; then
        echo "Commit any changes before continuing"
        git status
        return 1
    fi

    if ! mvn verify ; then
        echo "Your build failed. WOMP WOMP"
        return 1
    fi

    if ! git push origin $(current_branch) ; then
        return 1
    fi
    hubpr
}

