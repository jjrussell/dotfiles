############################################################
#
#  opencode
#
############################################################

# oh-my-openagent loads from the global config, so `opencode` runs it by default.
# opencode only loads plugins from discovered config dirs (global/home/project .opencode),
# NOT from OPENCODE_CONFIG/OPENCODE_CONFIG_DIR env vars, so a per-session opt-in alias
# isn't possible. `bare` uses --pure for a clean, plugin-free session when needed.
alias bare='opencode --pure'
alias oc='opencode'
