tmux_plugins_update() {
    pushd $HOME/.tmux/plugins || return
    for PLUGIN in * ; do
        echo "Updating plugin ${PLUGIN}"
        pushd $PLUGIN || return
        git pull || return
        popd || return
    done
    pushd
}


