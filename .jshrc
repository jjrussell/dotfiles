    # most common rsync usage - maybe add --delete to this to remove
    # files deleted in the source from the backup
    # use --no-g becuase users don't have permission to change group
    # ownership of files on hotplugged drives and --archive sets it.
    alias jrsync='rsync --archive --update --backup'

    local MVN_CMD="mvnd"

    alias mvndfast="$MVN_CMD  -DskipTests -DskipValidation -Dcheckstyle.skip -Dhs-swagger.skip=true compile "
    alias mvnfast="mvn -DskipTests -DskipValidation -Dcheckstyle.skip -Dhs-swagger.skip=true compile"
    alias mvnfastclean="mvnfast clean"
    # print out run some ruby code really fast. Good for calculator etc
    function r() {
        ruby -e "puts $*"
    }

    # Gentoo aliases
    if command -v emerge > /dev/null 2>&1 ; then
        # Run emerge at a lower process priority so the desktop is still
        # responsive, even if your updating
        alias emerge='nice -n 19 emerge'
        alias etags='etags --members' # gets public static vars in java
        alias unmerge='emerge --unmerge'
        alias qpkg='qpkg -i'
        alias cdport='cd /usr/portage'
        alias revdep-rebuild='revdep-rebuild -X'
    fi
fi

