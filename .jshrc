#############################################################
##
## AWS
##
#############################################################

if command -v aws > /dev/null 2>&1 ; then
    # aws tools have about 30 ways to find the credentials.
    # Set them all

    # The stuff below requires these env vars which are sourced from .secrets
    # PRODUCTION_AWS_ACCESS_KEY
    # PRODUCTION_AWS_SECRET_KEY
    # DEV_AWS_ACCESS_KEY
    # DEV_AWS_SECRET_KEY


    export AWS_CREDENTIAL_FILE=~/.ec2.tapjoy.creds
    export AWS_DEFAULT_REGION="us-east-1"
    export DEV_AWS_SECRET_ACCESS_KEY=$DEV_AWS_SECRET_KEY

    export EC2_CERT=~/.aws/cacert.pem
    export EC2_PRIVATE_KEY=~/.aws/privkey.pem

    function set_aws_creds(){
        cat << EOF > $AWS_CREDENTIAL_FILE
AWSAccessKeyId=$AWS_ACCESS_KEY
AWSSecretKey=$AWS_SECRET_KEY
EOF
        # different aws tools use different variables... of course
        export AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY
        export AWS_SECRET_ACCESS_KEY=$AWS_SECRET_KEY
        export TAPJOY_S3_KEY=${AWS_ACCESS_KEY_ID}
        export TAPJOY_S3_SECRET=${AWS_SECRET_ACCESS_KEY}
        # new aws cli
        ruby -pi -e 'gsub(/^aws_access_key_id.*/, "aws_access_key_id = #{ENV["AWS_ACCESS_KEY"]}")' ~/.aws/config
        ruby -pi -e 'gsub(/^aws_secret_access_key.*/, "aws_secret_access_key = #{ENV["AWS_SECRET_KEY"]}")' ~/.aws/config
    }

    # tapjoy production aws IAM keys for my user
    function prod() {
        export AWS_ACCESS_KEY=$PRODUCTION_AWS_ACCESS_KEY
        export AWS_SECRET_KEY=$PRODUCTION_AWS_SECRET_KEY
        set_aws_creds
    }

    # tapjoy qa account dev user keys
    function qa() {
        # dev account
        export AWS_ACCESS_KEY=$DEV_AWS_ACCESS_KEY
        export AWS_SECRET_KEY=$DEV_AWS_SECRET_KEY
        set_aws_creds
    }

    function aws_env() {
        env | grep AWS
    }

    # default to qa creds
    # qa
fi

