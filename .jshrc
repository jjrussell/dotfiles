alias gp='git push origin $(current_branch)'
alias ggpnp='git pull origin $(current_branch) && git push origin $(current_branch)'

alias got='git '
alias get='git '

function gcr2() {
    #!/bin/bash

    # gcr - Git Code Review
    # Written by Josh Dick <jodick@cisco.com>

    # Shows you all commits and files in a private branch that haven't been merged upstream,
    # and optionally performs an interactive diff.

    # By default, gcr will show *your* unmerged commits; gcr -a will show *all* unmerged commits.

    current_branch_name=`git name-rev --name-only HEAD 2> /dev/null`

    if [ $? -ne 0 ]; then
        echo "ERROR: `pwd` is not a Git repository."
        exit 1
    fi

    if [ "$current_branch_name" = master ]; then
        echo "ERROR: You must check out a private branch to use `basename $0`."
        exit 1
    fi

    git_user=`git config user.name`

    if [[ $1 = "-a" ]]; then
        echo -e "\n*** Showing commits from all authors. ***"
    else
        echo -e "\n*** Showing commits exclusively from author $git_user. ***"
    fi

    i=1
    for commit_id in `git cherry -v master | cut -d ' ' -f 2`
    do
        if [[ $1 = "-a" ]]; then
            commit_ids[$i]=$commit_id
            (( i++ ))
        else
            commit_author=`git log --format=%an -n 1 $commit_id`
            if [[ $commit_author = $git_user ]]; then
                commit_ids[$i]=$commit_id
                (( i++ ))
            fi
        fi
    done

    echo -e "\nRelevant unique commits on branch $current_branch_name:\n"

    for commit_id in ${commit_ids[@]}
    do
        echo `git log --format="%h (%an) %s" -n 1 $commit_id`
    done

    echo -e "\nList of all files changed in the above commits:"

    for commit_id in ${commit_ids[@]}
    do
        for changed_file in `git diff --name-only $commit_id $commit_id~1`
        do
            all_changed_files="$all_changed_files\n$changed_file"
        done
    done

    changed_files=`echo -e $all_changed_files | sort | uniq`
    echo -e "$changed_files\n"

    while true; do
        echo "Start interactive diff for above files? [y/n]"
        read yn
        case $yn in
            [Yy]* ) echo "Starting interactive diff for all files listed above..."; break;;
            [Nn]* ) echo "Exiting."; exit;;
            * ) echo "Please answer yes or no.";;
        esac
    done

    for file in $changed_files
    do
        echo "Starting interactive diff for $file..."
        git difftool master -- $file
    done

    echo "Interactive diff complete!"
}

