############################################################
#
#  Internal functions
#
############################################################
find_link_target ()
{
    # resolve symlinks until we find the actual startup script
    # $0 may be a softlink
    PRG="$1"

    while [ -h "$PRG" ]; do
        ls=$(\ls -ld "$PRG")
        link=$(expr "$ls" : '.*-> \(.*\)$')
        if expr "$link" : '.*/.*' > /dev/null; then
            PRG="$link"
        else
            PRG=$(dirname "$PRG")/"$link"
        fi
    done

    echo "$PRG"
}

find_link_target_dir ()
# output the directory containing the target of a symlink, or just
# dirname if its a normal file
{
    FILE=$(find_link_target $1)
    TARGET=$(dirname $FILE)
    if echo $TARGET | grep "^/" > /dev/null 2>&1 ; then
        # if this is an absolute link cd to dirname
        cd $(dirname $FILE)
    else
        # relative link use dirname of $1 as parent dir
        cd $(dirname $1)/$(dirname $FILE)
    fi
    echo $PWD
}

pathmunge ()
## If $1 is not in PATH then prepend it, else do nothing.
## If $2 is "after", then append $1 to PATH
## If $2 is before, then explicitly remove $1 from the
## path before prepending it.
{
    __debug "Inside pathmunge args $*"
    if [ ! -d "$1" ] ; then
        #echo "Can't add '$1' to the path as it doesn't exist"
        return
    fi
    
    # remove the path element from the path so we can prepend it later
              # can we just prepend it? Do we need to remove it?
    #if [ "$2" = "before" ] && which ruby > /dev/null ; then

        # __debug "_Before pathmunge ruby $(ruby -v) args $*"
        # PATH=$(echo $PATH | /usr/bin/ruby -F":" -ane "\$F.delete(\"$1\") ; puts \$F.uniq.join(\":\")")
        # __debug "_After pathmunge ruby args $*"
    #fi

    case ":${PATH}:" in
        *:$1:*) ;;
        *)
            if [ "$2" = "after" ] ; then
                PATH="${PATH}:$1"
            else
                PATH="$1:${PATH}"
            fi
            ;;
    esac
}

manpathmunge ()
## If $1 is not in MANPATH then prepend it, else do nothing.
## If $2 is "after", then append $1 to MANPATH
## If $2 is before, then explicitly remove $1 from the
## path before prepending it.
{
    if [ ! -d "$1" ] ; then
        #echo "Can't add '$1' to the manpath as it doesn't exist"
        return 1
    fi

    if [ "$2" = "before" ] ; then
        MANPATH=`echo $MANPATH | sed "s|:$1||g"`
    fi
    if ! echo $MANPATH | egrep "(^|:)$1($|:)" >/dev/null 2>&1; then
        if [ "$2" = "after" ] ; then
            MANPATH=$MANPATH:$1
        else
            MANPATH=$1:$MANPATH
        fi
    fi
}

bcd ()
# cd back until you find a directory that matches the argument. If nothing then cd ..
{
    cd "$(echo $PWD | grep -o ".*/$1")"
}


# Pushes local SSH public key to another box - found at https://github.com/rtomayko/dotfiles/blob/rtomayko/.bashrc
push_ssh() {
    local _host
    local SSH_PORT=22
    test -f ~/.ssh/id_dsa.pub || ssh-keygen -t dsa
    for _host in "$@";
    do
        ssh -q -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no -o NumberOfPasswordPrompts=0 -p $SSH_PORT $_host "echo Testing" &> /dev/null
        if [ $? -ne 0 ]; then
            echo "Pushing public key to $_host..."
            ssh -q -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no -p $SSH_PORT $_host "mkdir -p ~/.ssh && cat >> ~/.ssh/authorized_keys" < ~/.ssh/id_dsa.pub
        else
            echo "Passwordless SSH access for $_host is already configured"
        fi
    done
}

push_ssh_and_login(){
    ssh -o NumberOfPasswordPrompts=0 "$@"
    if [ $? -ne 0 ]; then
        push_ssh "$@"
        ssh -o NumberOfPasswordPrompts=0 "$@"
    fi
}


# Functions that used to be aliases
pseg()
{
    #ps -e -o pid,user,args | grep -v grep | egrep -i "(PID USER|$1)"
    ps -e -o pid,user,command | grep -v grep | egrep -i "$1"
}

ifind()
{
    find  . -follow -iname "*$**"
}

# Extracts archives - found at http://pastebin.com/CTra4QTF
extract() {
    case $@ in
        *.tar.bz2) tar -xvjf "$@" ;;
        *.tar.gz) tar -xvzf "$@" ;;
        *.bz2) bunzip2 "$@" ;;
        *.rar) unrar x "$@" ;;
        *.gz) gunzip "$@" ;;
        *.tar) tar xf "$@" ;;
        *.tbz2) tar -xvjf "$@" ;;
        *.tgz) tar -xvzf "$@" ;;
        *.zip) unzip "$@" ;;
        *.xpi) unzip "$@" ;;
        *.Z) uncompress "$@" ;;
        *.7z) 7z x "$@" ;;
        *.ace) unace e "$@" ;;
        *.arj) arj -y e "$@" ;;
        *) echo "'$@' cannot be extracted via $0()" ;;
    esac
}

# move the target thing to our internal home directory and symlink it back to where it used to be
internalize() {
    local INTERNAL_HOME="${HOME}/Dropbox/jjr-environment/home"
    mv -v "$1" ${INTERNAL_HOME} && ln -s -v "${INTERNAL_HOME}/$1" .
}

