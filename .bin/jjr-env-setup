function hubspot_setup() {
    if [ ! -e "$HUBSPOT_KICKSTART" ] ; then
        echo "executing HubSpot kickstart script https://private.hubteam.com/kickstart/start.sh"
        echo "Enter to proceed, Ctrl-C to stop"
        read
        sh -c "$(curl --fail https://private.hubteam.com/kickstart/start.sh)"
        touch "$HUBSPOT_KICKSTART"
    else
        echo "HubSpot kickstart already run. Skipping"
        echo "To run it again delete $HUBSPOT_KICKSTART"
    fi
