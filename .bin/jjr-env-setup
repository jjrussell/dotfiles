function link_home_dir(){
    pushd ~
    local RESOURCE=false
    if [ ! -d "${JJR_HOME}" ] ; then
        echo "It looks like Google Drive hasn't been set up yet. Make sure that's working"
        exit 1
    fi
    for DOT in `ls -A ${JJR_HOME}` ; do
        if [ ! "${DOT}" = ".git" ] ; then
            if [ -e ${HOME}/$DOT ] && [ ! -h ${HOME}/$DOT ] ; then # exists and isn't already a symlink
                mv -v ${HOME}/$DOT ${HOME}/$DOT.orig
                RESOURCE=true
            fi
            ln -sfv ${JJR_HOME}/$DOT . # this will clobber all existing symlinks so the command is idempotent
        fi
    done
    if $RESOURCE ; then
        echo "Re-source dot files and rerun this command: $0"
        exit 1
    fi
    
    popd > /dev/null
    echo "Home directory linked"
}

function install_google_drive(){
    if ! pgrep -ilq "Google Drive" ; then
        if $DARWIN ; then
            if ! open -a "Google Drive" ; then
                echo "Google Drive doesn't appear to be installed. Installing it."
                brew_cask_install "google-drive"
                open -a "Google Drive"
            fi

            echo "Google Backup and Sync wasn't running. Starting it up."
        else
            echo "Go install Google Drive."
        fi
        echo "Press enter when offline syncing of jjr-environment directory is done."
        read
    else
        echo "Google Drive is running. Moving on"
    fi
}

function install_ruby() {
    if ! which rvm > /dev/null ; then
        echo "Installing rvm ruby and basic gems"
        \curl -sSL https://get.rvm.io | bash -s -- --ignore-dotfiles
        rvm install ruby
        #source ~/.bashrc # reread rvm config
        rvm all do gem install awesome_print bundle fog json mixlib-cli pry pry-stack_explorer pry-doc ripper-tags rubygems
    fi
}


