populate_nautilus_scripts()
{
	if ! which nautilus ; then
		echo "nautilus not found in path, skipping nautilus script installation"
		return
	fi

#link up nautilus scripts
    echo "Populating nautilus scripts"
    NAUTILUS_SCRIPT_DIR="$HOME/.gnome2/nautilus-scripts"
    [ ! -d $NAUTILUS_SCRIPT_DIR ] && ${MKDIR} -p $NAUTILUS_SCRIPT_DIR
    ln -sf "$JJR_BIN/email-file" "$NAUTILUS_SCRIPT_DIR/Attach to email"
    ln -sf "$JJR_BIN/jjr-terminal" "$NAUTILUS_SCRIPT_DIR/Open Terminal Here"
    ln -sf "$JJR_BIN/jjr-gconf-set-background" "$NAUTILUS_SCRIPT_DIR/Set as Desktop Background"
    ln -sf "$JJR_BIN/toggle-mount" "$NAUTILUS_SCRIPT_DIR/Toggle Mount Point"
    ln -sf "$JJR_BIN/jjr-copy-to-home" "$NAUTILUS_SCRIPT_DIR/Copy to Home Computer"
    ln -sf "$JJR_BIN/jjr-gnome-search" "$NAUTILUS_SCRIPT_DIR/Search"
    ln -sf "$JJR_BIN/mount-iso" "$NAUTILUS_SCRIPT_DIR/Mount ISO Image"
    ln -sf "$JJR_BIN/xinerama-background-maker" "$NAUTILUS_SCRIPT_DIR/Make Xinerama Background (2 Images)"
}

link_emacs()
{
    echo "Linking emacs files"


# to make relative links work
    cd $HOME
	# this should already exist as a symlink after running link_dot_files
    EMACS_HOME=".emacs.d"
    [ -r $EMACS_HOME/.emacs ] && ln -sf $EMACS_HOME/.emacs
    [ -r $EMACS_HOME/init/.gnus ]  && ln -sf $EMACS_HOME/init/.gnus 
    [ -r $EMACS_HOME/init/.newsrc ]  && ln -sf $EMACS_HOME/init/.newsrc 
    [ -r $EMACS_HOME/init/.newsrc.eld ] &&  ln -sf $EMACS_HOME/init/.newsrc.eld 
}

set_gconf_defaults()
{
	if ! which gconftool-2 ; then
		echo "gconftool-2 not found in path, skipping gconf config"
		return
	fi

    echo "Setting gconf defaults"

# Nautilus settings
# Clean icons off desktop
    gconftool-2 --set --type Boolean /apps/nautilus/desktop/computer_icon_visible false
    gconftool-2 --set --type Boolean /apps/nautilus/desktop/home_icon_visible false
    gconftool-2 --set --type Boolean /apps/nautilus/desktop/trash_icon_visible false
    gconftool-2 --set --type Boolean /apps/nautilus/preferences/always_use_browser true
    gconftool-2 --set --type String /apps/nautilus/preferences/default_folder_viewer "list_view"
    gconftool-2 --set --type Boolean /apps/nautilus/preferences/desktop_is_home_dir true
    gconftool-2 --set --type Boolean /apps/nautilus/preferences/enable_delete true
# unixy permission dialog
    gconftool-2 --set --type Boolean /apps/nautilus/preferences/show_advanced_permissions true
    # emacs-like text editing
    gconftool-2 --set --type string /desktop/gnome/interface/gtk_key_theme Emacs
}

#############################################################
##
## main execution of functions above
##
############################################################# 
link_home_dot_files
link_emacs
populate_nautilus_scripts
set_gconf_defaults