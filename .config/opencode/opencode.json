{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "oh-my-openagent@latest",
    "@tarquinen/opencode-dcp@latest"
  ],
  "mcp": {
    "todoist": {
      "type": "remote",
      "url": "https://ai.todoist.net/mcp",
      "enabled": true
    }
  },
  "permission": {
    "skill": {
      "*": "allow"
    },
    "external_directory": {
      "~/src/**": "allow",
      "~/.cache/opencode/**": "allow",
      "~/.dotfiles/.agents/**": "allow",
      "/tmp/**": "allow",
      "~/.m2/**": "allow",
      "~/.hubspot/**": "allow",
      "~/.codex/**": "allow"
    },
    "read": {
      "~/src/**": "allow",
      "~/.cache/opencode/**": "allow",
      "~/.dotfiles/.agents/**": "allow",
      "/tmp/**": "allow",
      "~/.m2/**": "allow",
      "~/.hubspot/**": "allow",
      "~/.codex/**": "allow"
    },
    "edit": {
      "~/src/**": "allow",
      "~/.cache/opencode/**": "allow",
      "~/.dotfiles/.agents/**": "allow",
      "/tmp/**": "allow",
      "~/.m2/**": "allow",
      "~/.hubspot/static-archive/**": "allow",
      "~/.codex/**": "allow"
    }
  }
}
